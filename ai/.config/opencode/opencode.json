{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "alibaba": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000,
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3/qwen3-coder-next": {
          "name": "Qwen3 Coder Next (Local)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9B (Local)",
          "limit": {
            "context": 8192,
            "output": 8192
          }
        },
        "gemma-4-e4b": {
            "name": "Gemma 4 (Local)",
            "limit": {
                "context": 131072,
                "output": 8192
            }
        }
      }
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tools": {
    "write": true,
    "zsh": true,
    "python": true,
    "code": true,
    "files": true,
    "terminal": true,
    "git": true,
    "docker": false,
    "kubernetes": false,
    "terraform": false,
    "ansible": false
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "deny",
      "git log": "allow",
      "git log *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "npm *": "ask",
      "npm show *": "allow",
      "npm run check *": "allow",
      "npm run test:e2e": "allow",
      "npx prisma generate *": "allow",
      "rm *": "deny",
      "grep *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "head *": "allow",
    },
    "edit": {
      "*": "ask",
      "README.md": "allow",
      "docs/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.envrc": "deny"
    },
    "skill": {
      "*": "ask"
    }
  }
}